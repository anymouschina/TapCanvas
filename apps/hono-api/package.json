{
	"name": "@tapcanvas/api",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "node --watch -r ts-node/register/transpile-only -r tsconfig-paths/register src/main.ts",
		"dev:stable": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/main.ts",
		"dev:log": "DEBUG_HTTP_LOG=1 pnpm dev 2>&1 | tee log.txt",
		"build": "node scripts/build.mjs",
		"import:ai-character-library": "node scripts/import-ai-character-library.mjs",
		"prisma:generate": "prisma generate",
		"db:pg:backup": "node scripts/backup-postgres.mjs",
		"db:pg:schema": "node scripts/bootstrap-postgres-schema.mjs",
		"db:pg:migrate": "node scripts/migrate-deploy.mjs",
		"db:pg:seed-patches": "node scripts/seed-postgres-patches.mjs",
		"gen:style-cards": "node scripts/generate-style-reference-cards.mjs",
		"sync:new-api:catalog": "node scripts/sync-new-api-catalog.mjs",
		"sync:system-skills": "node scripts/sync-system-skills.mjs",
		"sync:system-knowledge": "node scripts/sync-system-knowledge.mjs",
		"sync:skill-marketplace": "node scripts/sync-skill-marketplace.mjs",
		"sync:skill-marketplace:apply": "node scripts/sync-skill-marketplace.mjs --apply",
		"db:migrate:sqlite-to-pg": "node scripts/migrate-sqlite-to-postgres.mjs",
		"start": "node dist/main.js",
		"smoke:project-chapter": "node scripts/project-chapter-smoke.mjs",
		"ai-delivery:acceptance": "node scripts/ai-delivery-acceptance.mjs",
		"test:ai-delivery:acceptance": "node --test scripts/ai-delivery-acceptance-contract.test.mjs",
		"test:system-knowledge": "node --test scripts/system-knowledge-sync.test.mjs",
		"audit:commerce:catalog": "node scripts/audit-commerce-catalog.mjs",
		"migrate:runtime-assets:tos": "node scripts/migrate-runtime-assets-to-tos.mjs",
		"archive:prompt-library-media:r2": "node -r ts-node/register/transpile-only scripts/archive-prompt-library-media-r2.ts",
		"test": "vitest run",
		"test:integration:real-auth": "REAL_AUTH_TEST_BASE_URL=http://127.0.0.1:8788 vitest run src/modules/auth/auth.real-token.test.ts --environment node --reporter=dot",
		"test:integration:continuation-chaos": "node scripts/run-continuation-settlement-chaos.mjs",
		"test:integration:continuation-chaos:external": "vitest run src/modules/task/continuation-settlement.chaos.integration.test.ts --environment node --reporter=verbose",
		"async-image:worker": "node dist/async-image-worker.js",
		"async-image:worker:health": "node dist/async-image-worker-health.js",
		"inprocess:worker": "node dist/inprocess-worker.js",
		"inprocess:worker:health": "node dist/inprocess-worker-healthcheck.js",
		"workflow-runtime:worker": "node dist/workflow-runtime-worker.js",
		"prompt-evolution:worker": "node scripts/prompt-evolution-worker.mjs",
		"codex-remote-builder": "node dist/codex-remote-builder.js",
		"codex-remote-builder:dev": "node -r ts-node/register/transpile-only scripts/codex-remote-builder.ts",
		"docker:up": "docker-compose up --build api agents-bridge",
		"docker:up:all": "docker-compose up",
		"docker:restart": "docker-compose restart api",
		"docker:build:newapi": "docker-compose build new-api"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^2.0.45",
		"@ai-sdk/google": "^2.0.39",
		"@ai-sdk/openai": "^2.0.69",
		"@alicloud/credentials": "^2.4.4",
		"@alicloud/dm20151123": "^1.9.2",
		"@alicloud/openapi-client": "^0.4.15",
		"@alicloud/tea-util": "^1.4.11",
		"@aws-sdk/client-s3": "^3.978.0",
		"@aws-sdk/s3-request-presigner": "^3.978.0",
		"@grpc/grpc-js": "^1.12.5",
		"@grpc/proto-loader": "^0.7.13",
		"@hono/zod-openapi": "^0.19.10",
		"@langchain/core": "1.2.5",
		"@langchain/langgraph": "1.4.9",
		"@langchain/langgraph-checkpoint-postgres": "1.0.4",
		"@napi-rs/canvas": "^0.1.96",
		"@nestjs/common": "^11.0.10",
		"@nestjs/core": "^11.0.10",
		"@nestjs/platform-express": "^11.0.10",
		"@prisma/client": "^6.12.0",
		"@vercel/sandbox": "2.9.2",
		"@xmldom/xmldom": "^0.8.10",
		"ai": "^5.0.97",
		"bullmq": "^5.58.3",
		"cron-parser": "5.8.1",
		"dotenv": "^16.4.5",
		"fflate": "^0.8.3",
		"hono": "^4.6.20",
		"ioredis": "^5.6.1",
		"jsonrepair": "^3.13.1",
		"lib0": "^0.2.117",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"undici": "^7.16.0",
		"ws": "^8.21.0",
		"y-protocols": "^1.0.7",
		"yjs": "^13.6.31",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260124.0",
		"@types/node": "^22.13.0",
		"@types/ws": "^8.18.1",
		"esbuild": "^0.27.0",
		"prisma": "^6.19.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "4.2.0",
		"typescript": "^5.6.3",
		"vitest": "^1.6.1",
		"y-websocket": "^3.0.0"
	}
}
