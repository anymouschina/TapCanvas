// 视频整片后台自主驱动：持久化一次整章 run 的状态，供后台 worker 续跑到 concatenated。
model video_runs {
  id                  String  @id
  owner_id            String
  flow_id             String?
  project_id          String?
  chapter_id          String?
  recipe_id           String?
  state               String  @default("scheduled")
  story_plan          String?
  // run 级全片圣经（directorTone/visualBible/hardRules·JSON 文本）：随首批 add_clips 落库，api 重启不丢（2026-07-04 小说→分镜改造）。
  film_bible          String?
  // 改编策略（reversals/cuts/hook·JSON 文本）：与 film_bible 同机制随首批提交持久化，供 critic 第21维「改编胆量」审读。
  adaptation_strategy String?
  // 【编排域状态机 P1·2026-07-11】BeatSheet 原子产物（JSON 文本·commit_beats 写入即校验后落库）。
  // 有值=该 run 走统一 delivery graph；null 只允许没有 BeatSheet 的独立 direct-video run。
  beat_sheet          String?
  // authoring 创作态（adapting/beats_committed/writing_dispatched/assembled/reviewing/script_approved/
  // deriving_assets/assets_ready/estimate_ready/authoring_failed）。与生产态 state 正交：state 仍从
  // collecting→scheduled→…走原状态机，authoring_state 只管 start 之前的创作半场。
  authoring_state     String?
  total_clips         Int     @default(0)
  clips_done          Int     @default(0)
  error_message       String?
  last_drive_at       String?
  created_at          String
  updated_at          String
  completed_at        String?

  @@index([state, updated_at], map: "idx_video_runs_state_updated")
  @@index([flow_id, state], map: "idx_video_runs_flow_state")
  @@index([authoring_state, updated_at], map: "idx_video_runs_authoring_state")
}

// 【编排域状态机·8.1 build-system 底座·2026-07-11】创作半场原子产物登记：内容 hash + 依赖边。
// artifact_key 形如 "beat_sheet" / "batch:0" / "clip:4" / "review:1" / "asset:character:孟川"。
// 修改某产物=失效其下游闭包（derived_from 反向遍历），只重算被污染子图——「改镜4台词」只重做镜4。
model authoring_artifacts {
  id           String  @id
  run_id       String
  artifact_key String
  content_hash String
  // JSON 数组：上游 artifact_key 列表（依赖边）。
  derived_from String  @default("[]")
  // pending|running|waiting_external|ready|failed|stale
  status       String  @default("pending")
  // 小型产物内容/指针（JSON 文本·大产物只存引用如 story_plan 内 clipIndex）。
  payload      String?
  error        String?
  created_at   String
  updated_at   String

  @@unique([run_id, artifact_key], map: "uq_authoring_artifacts_run_key")
  @@index([run_id, status], map: "idx_authoring_artifacts_run_status")
}

// 外部副作用账本。每个 revision 永久保留；provider 已受理或资产已物化后只允许向前推进，
// 不得由重试、替换或后处理覆盖。production_workflow_events 保存每次状态变化的追加式事实。
model production_effects {
  id               String  @id
  run_id           String
  workflow_node_id String
  effect_key       String
  revision         Int     @default(1)
  operation        String
  input_hash       String
  status           String  @default("reserved")
  provider         String?
  provider_task_id String?
  provider_receipt String?
  asset_url        String?
  error_code       String?
  error_message    String?
  created_at       String
  updated_at       String
  accepted_at      String?
  materialized_at  String?
  finished_at      String?

  @@unique([run_id, effect_key, revision], map: "uq_production_effects_run_key_revision")
  @@index([run_id, workflow_node_id, status], map: "idx_production_effects_run_node_status")
  @@index([provider, provider_task_id], map: "idx_production_effects_provider_task")
}

model production_workflow_events {
  id               String  @id
  run_id           String
  seq              Int
  workflow_node_id String
  event_kind       String
  payload_ref      String?
  artifact_ids     String  @default("[]")
  effect_ids       String  @default("[]")
