  logical_task_id   String?
  root_trace_id     String?
  parent_trace_id   String?
  physical_run_id   String?
  workflow_run_id   String?
  events            execution_trace_events[]

  @@index([user_id, scope_type, scope_id, created_at(sort: Desc)], map: "idx_execution_traces_user_scope")
  @@index([user_id, root_trace_id, started_at], map: "idx_execution_traces_root_started")
  @@index([user_id, logical_task_id, started_at], map: "idx_execution_traces_logical_task")
  @@index([user_id, status, updated_at], map: "idx_execution_traces_user_status_updated")
  @@index([user_id, parent_trace_id], map: "idx_execution_traces_parent")
}

