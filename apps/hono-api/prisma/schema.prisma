  current_url        String?
  error_message      String?
  started_at         String?
  finished_at        String?
  created_at         String
  updated_at         String

  @@index([status, created_at], map: "idx_prompt_library_crawl_runs_status_created")
}

model prompt_library_crawl_targets {
  id               String  @id
  run_id           String
  source_url       String
  source_prompt_id String
  status           String
  attempts         Int     @default(0)
  entry_id         String?
  error_message    String?
  created_at       String
  updated_at       String

  @@unique([run_id, source_url], map: "idx_prompt_library_crawl_targets_run_url")
  @@index([run_id, status, created_at], map: "idx_prompt_library_crawl_targets_run_status")
}
