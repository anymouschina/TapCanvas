generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model agent_pipeline_runs {
  id            String   @id
  owner_id      String
  project_id    String
  title         String
  goal          String?
  status        String
  stages_json   String
  progress_json String?
  result_json   String?
  error_message String?
  created_at    String
  updated_at    String
  started_at    String?
  finished_at   String?
  users         users    @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projects      projects @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([owner_id, project_id, updated_at(sort: Desc)], map: "idx_agent_pipeline_runs_owner_project_updated")
  @@index([owner_id, status, updated_at(sort: Desc)], map: "idx_agent_pipeline_runs_owner_status_updated")
}

model agent_presets {
  id              String  @id
  key             String  @unique
  name            String
  description     String?
  system_prompt   String?
  opening_message String?
  skill_ids       String?
  enabled         Int     @default(1)
  visible         Int     @default(1)
  sort_order      Int?
  created_at      String
  updated_at      String

  @@index([enabled, visible, sort_order], map: "idx_agent_presets_enabled_visible_sort")
}

model agent_skills {
  id          String  @id
  key         String  @unique
  name        String
  description String?
  content     String
  logo_url    String?
  category    String  @default("系统技能")
  enabled     Int     @default(1)
  visible     Int     @default(1)
  sort_order  Int?
  created_at  String
  updated_at  String

  @@index([enabled, visible, sort_order], map: "idx_agent_skills_enabled_visible_sort")
}

model user_skill_assets {
  id                            String  @id
  owner_id                      String
  file_name                     String
  name                          String
  description                   String?
  content                       String
  logo_url                      String?
  force_full_context            Int     @default(0)
  size_bytes                    Int
  sha256                        String
  marketplace_product_id        String?
  marketplace_price_cents       Int?
  marketplace_currency          String?
  marketplace_listed_at         String?
  source_marketplace_product_id String?
  created_at                    String
  updated_at                    String
  users                         users   @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([owner_id, file_name], map: "idx_user_skill_assets_owner_file")
  @@index([owner_id, updated_at(sort: Desc)], map: "idx_user_skill_assets_owner_updated")
  @@index([marketplace_product_id], map: "idx_user_skill_assets_marketplace_product")
  @@index([source_marketplace_product_id], map: "idx_user_skill_assets_source_product")
}

model agent_capability_attachments {
  id                       String @id
  user_id                  String
  capability_kind          String
  source_id                String
  source_version_id        String
  descriptor_json          String
  descriptor_sha256        String
  conflict_report_json     String
  route_decisions_json     String?
  conflict_report_revision Int    @default(1)
  scope                    String @default("current_user")
  created_at               String
  updated_at               String
  users                     users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, capability_kind, source_id], map: "uq_agent_capability_attachments_user_source")
  @@index([user_id, updated_at(sort: Desc)], map: "idx_agent_capability_attachments_user_updated")
  @@index([source_version_id], map: "idx_agent_capability_attachments_source_version")
  @@index([scope], map: "idx_agent_capability_attachments_scope")
}

model agent_capability_preferences {
  id                        String @id
  user_id                   String
  capability_kind           String
  capability_id             String
  enabled                   Int    @default(1)
  disabled_reason           String?
  replaced_by_capability_id String?
  created_at                String
  updated_at                String
  users                     users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, capability_kind, capability_id], map: "uq_agent_capability_preferences_user_capability")
  @@index([user_id, enabled, updated_at(sort: Desc)], map: "idx_agent_capability_preferences_user_enabled")
  @@index([replaced_by_capability_id], map: "idx_agent_capability_preferences_replaced_by")
}

model agent_builtin_capability_settings {
  capability_id     String @id
  enabled           Int    @default(1)
  updated_by_user_id String
  created_at        String
  updated_at        String
  users             users  @relation(fields: [updated_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([enabled, updated_at(sort: Desc)], map: "idx_agent_builtin_capability_settings_enabled")
  @@index([updated_by_user_id], map: "idx_agent_builtin_capability_settings_updated_by")
}

model agent_capability_invocations {
  id                    String              @id
  user_id               String
  attachment_id         String
  capability_id         String
  capability_name       String
  source_id             String
  source_version_id     String
  descriptor_sha256     String
  workflow_execution_id String              @unique(map: "uq_agent_capability_invocations_execution")
  agent_execution_id    String?
  session_id            String?
  tool_call_id          String?
  input_json            String?
  created_at            String
  updated_at            String
  users                 users               @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workflow_executions   workflow_executions @relation(fields: [workflow_execution_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "idx_agent_capability_invocations_user_created")
  @@index([attachment_id, created_at(sort: Desc)], map: "idx_agent_capability_invocations_attachment_created")
  @@index([agent_execution_id], map: "idx_agent_capability_invocations_agent_execution")
  @@index([session_id], map: "idx_agent_capability_invocations_session")
}

model skill_favorites {
  id         String @id
  user_id    String
  skill_key  String
  created_at String
  users      users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, skill_key], map: "idx_skill_favorites_user_skill")
  @@index([user_id, created_at(sort: Desc)], map: "idx_skill_favorites_user_created")
}

model api_keys {
  id              String  @id
  owner_id        String
  label           String
  key_prefix      String
  key_hash        String  @unique(map: "idx_api_keys_hash")
  allowed_origins String
  enabled         Int     @default(1)
  kind            String  @default("user")
  billing_team_id String?
  scopes          String  @default("[\"public:read\"]")
  expires_at      String?
  revoked_at      String?
  rotated_from_id String?
  last_used_at    String?
  created_at      String
  updated_at      String
  users           users   @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([owner_id], map: "idx_api_keys_owner")
}

model api_request_logs {
  id          String  @id
  user_id     String?
  api_key_id  String?
  method      String
  path        String
  status      Int?
  stage       String?
  aborted     Int     @default(0)
  started_at  String
  finished_at String?
  duration_ms Int?
  trace_json  String?
  created_at  String
  updated_at  String

  @@index([path, started_at], map: "idx_api_request_logs_path_started_at")
  @@index([started_at], map: "idx_api_request_logs_started_at")
  @@index([user_id, started_at], map: "idx_api_request_logs_user_started_at")
}

model assets {
  id         String    @id
  name       String
  data       String?
  owner_id   String
  project_id String?
  created_at String
  updated_at String
  users      users     @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projects   projects? @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([owner_id], map: "idx_assets_owner")
  @@index([project_id], map: "idx_assets_project")
}

model commerce_dictionaries {
  id         String  @id
  owner_id   String
  dict_type  String
  code       String
  name       String
  value_json String?
  enabled    Int     @default(1)
  sort_order Int     @default(0)
  created_at String
  updated_at String
  users      users   @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([owner_id, dict_type, code])
  @@index([owner_id, dict_type, sort_order, code], map: "idx_commerce_dict_owner_type_sort")
}

model detail_page_evolution_runs {
  id            String @id
  owner_id      String
  min_feedbacks Int
  action        String
  metrics_json  String
  created_at    String
  users         users  @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([owner_id, created_at(sort: Desc)], map: "idx_detail_page_evolution_runs_owner_created")
}

model detail_page_feedback_logs {
  id                  String              @id
  owner_id            String
  generation_id       String?
  sample_id           String
  score_overall       Int
  score_structure     Int?
  score_visual        Int?
  score_conversion    Int?
  edit_ratio          Float?              @db.Real
  note                String?
  created_at          String
  users               users               @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  detail_page_samples detail_page_samples @relation(fields: [sample_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([owner_id, created_at(sort: Desc)], map: "idx_detail_page_feedback_logs_owner_created")
  @@index([owner_id, sample_id, created_at(sort: Desc)], map: "idx_detail_page_feedback_logs_owner_sample")
}

model detail_page_retrieval_logs {
  id                  String              @id
  owner_id            String
  query_text          String?
  category            String?
  sample_id           String
  rank_no             Int                 @default(0)
  score               Float               @default(0) @db.Real
  created_at          String
  users               users               @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  detail_page_samples detail_page_samples @relation(fields: [sample_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([owner_id, created_at(sort: Desc)], map: "idx_detail_page_retrieval_logs_owner_created")
  @@index([owner_id, sample_id, created_at(sort: Desc)], map: "idx_detail_page_retrieval_logs_owner_sample")
}

model detail_page_samples {
  id                         String                       @id
  owner_id                   String
  title                      String
  category                   String
  tags_json                  String                       @default("[]")
  source                     String?
  image_url                  String?
  summary                    String?
  modules_json               String?
  copy_json                  String?
  style_json                 String?
  score_quality              Float                        @default(0) @db.Real
  score_visual               Float                        @default(0) @db.Real
  score_conversion           Float                        @default(0) @db.Real
  usage_count                Int                          @default(0)
  last_used_at               String?
  created_at                 String
  updated_at                 String
  detail_page_feedback_logs  detail_page_feedback_logs[]
  detail_page_retrieval_logs detail_page_retrieval_logs[]
  users                      users                        @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([owner_id, category, updated_at(sort: Desc)], map: "idx_detail_page_samples_owner_category")
  @@index([owner_id, updated_at(sort: Desc)], map: "idx_detail_page_samples_owner_updated")
}

model email_login_codes {
  id         String  @id
  email      String
  code_salt  String
  code_hash  String
  expires_at String
  used_at    String?
  created_at String
  updated_at String

  @@index([email, created_at], map: "idx_email_login_codes_email_created_at")
  @@index([email, expires_at], map: "idx_email_login_codes_email_expires_at")
}

model flow_versions {
  id                  String                @id
  flow_id             String
  name                String
  data                String
  user_id             String?
  created_at          String
  flows               flows                 @relation(fields: [flow_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users               users?                @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workflow_executions workflow_executions[]

  @@index([flow_id], map: "idx_flow_versions_flow_id")
  @@index([user_id], map: "idx_flow_versions_user_id")
}

model flows {
  id                  String                @id
  name                String
  data                String
  owner_id            String?
  project_id          String?
  created_at          String
  updated_at          String
  canvas_revision     Int                   @default(0) // 乐观锁版本号，source:'user' 保存成功 +1
  flow_versions       flow_versions[]
  users               users?                @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projects            projects?             @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workflow_executions workflow_executions[]

  @@index([owner_id], map: "idx_flows_owner_id")
  @@index([project_id], map: "idx_flows_project_id")
}

model chapters {
  id                     String   @id
  owner_id               String
  project_id             String
  chapter_index          Int
  title                  String
  summary                String?
  status                 String
  sort_order             Int
  cover_asset_id         String?
  continuity_context     String?
  style_profile_override String?
  legacy_chunk_index     Int?
  source_book_id         String?
  source_book_chapter    Int?
  last_worked_at         String?
  created_at             String
  updated_at             String
  canvas_flow            String? // 章节画布 flow JSON 序列化字符串，null 表示尚未初始化
  canvas_flow_revision   Int      @default(0) // 乐观锁版本号，每次 PUT 成功 +1
  adaptation_contract    String? // 【编排域 P2·2026-07-11】章级改编合同（reversals/cuts/hook JSON）——run 只引用；重制 run 声明与它 diff，弱化/删项确定性告警
  film_spec              String? // 【章级交付范围】仅持久化 deliveryScope/targetDurationSeconds/adaptationMode/notes/filmGenre；模型规格来自本轮生成合同，质量复盘不作为出片门禁
  users                  users    @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projects               projects @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([project_id, chapter_index], map: "idx_chapters_project_index_unique")
  @@index([owner_id, project_id, sort_order], map: "idx_chapters_owner_project_sort")
  @@index([project_id, last_worked_at], map: "idx_chapters_project_last_worked")
}

model llm_node_presets {
  id          String  @id
  owner_id    String?
  scope       String
  preset_type String
  title       String
  prompt      String
  description String?
  meta        String?
  enabled     Int     @default(1)
  sort_order  Int?
  created_at  String
  updated_at  String
  users       users?  @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([owner_id, preset_type], map: "idx_llm_node_presets_owner_type")
  @@index([scope, preset_type, enabled], map: "idx_llm_node_presets_scope_type_enabled")
}

model merchants {
  id           String         @id
  owner_id     String         @unique
  name         String
  status       String         @default("active")
  created_at   String
  updated_at   String
  users        users          @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_skus product_skus[]
  products     products[]

  @@index([owner_id], map: "idx_merchants_owner_id")
  @@index([status], map: "idx_merchants_status")
}

model model_catalog_mappings {
  id                    String                @id
  vendor_key            String
  task_kind             String
  name                  String
  enabled               Int                   @default(1)
  request_mapping       String?
  response_mapping      String?
  created_at            String
  updated_at            String
  model_catalog_vendors model_catalog_vendors @relation(fields: [vendor_key], references: [key], onDelete: Cascade, onUpdate: NoAction)

  @@unique([vendor_key, task_kind, name])
  @@index([vendor_key, task_kind], map: "idx_model_catalog_mappings_vendor_kind")
}

model model_catalog_models {
  model_key             String
  vendor_key            String
  model_alias           String?
  label_zh              String
  kind                  String
  enabled               Int                   @default(1)
  meta                  String?
  created_at            String
  updated_at            String
  model_catalog_vendors model_catalog_vendors @relation(fields: [vendor_key], references: [key], onDelete: Cascade, onUpdate: NoAction)

  @@id([vendor_key, model_key])
  @@index([enabled], map: "idx_model_catalog_models_enabled")
  @@index([vendor_key, kind], map: "idx_model_catalog_models_vendor_kind")
}

model model_catalog_vendor_api_keys {
  vendor_key            String                @id
  api_key               String
  enabled               Int                   @default(1)
  created_at            String
  updated_at            String
  model_catalog_vendors model_catalog_vendors @relation(fields: [vendor_key], references: [key], onDelete: Cascade, onUpdate: NoAction)
}

model model_catalog_vendors {
  key                           String                         @id
  name                          String
  enabled                       Int                            @default(1)
  base_url_hint                 String?
  auth_type                     String                         @default("bearer")
  auth_header                   String?
  auth_query_param              String?
  meta                          String?
  created_at                    String
  updated_at                    String
  model_catalog_mappings        model_catalog_mappings[]
  model_catalog_models          model_catalog_models[]
  model_catalog_vendor_api_keys model_catalog_vendor_api_keys?
}

model model_credit_cost_specs {
  model_key  String
  spec_key   String
  cost       Int
  enabled    Int    @default(1)
  created_at String
  updated_at String

  @@id([model_key, spec_key])
  @@index([model_key], map: "idx_model_credit_cost_specs_model_key")
}

model model_credit_costs {
  model_key  String @id
  cost       Int
  enabled    Int    @default(1)
  created_at String
  updated_at String
}

model model_endpoints {
  id              String          @id
  provider_id     String
  key             String
  label           String
  base_url        String
  shared          Int             @default(0)
  created_at      String
  updated_at      String
  model_providers model_providers @relation(fields: [provider_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([provider_id, key])
  @@index([provider_id], map: "idx_model_endpoints_provider_id")
}

model model_profiles {
  id              String          @id
  owner_id        String
  provider_id     String
  name            String
  kind            String
  model_key       String
  settings        String?
  created_at      String
  updated_at      String
  users           users           @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  model_providers model_providers @relation(fields: [provider_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([owner_id], map: "idx_model_profiles_owner")
  @@index([provider_id], map: "idx_model_profiles_provider")
}

model model_providers {
  id              String            @id
  name            String
  vendor          String
  base_url        String?
  shared_base_url Int               @default(0)
  owner_id        String
  created_at      String
  updated_at      String
  model_endpoints model_endpoints[]
  model_profiles  model_profiles[]
  users           users             @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  model_tokens    model_tokens[]

  @@index([owner_id], map: "idx_model_providers_owner_id")
  @@index([vendor], map: "idx_model_providers_vendor")
}

model model_tokens {
  id                     String                @id
  provider_id            String
  label                  String
  secret_token           String
  user_agent             String?
  user_id                String
  enabled                Int                   @default(1)
  shared                 Int                   @default(0)
  shared_failure_count   Int                   @default(0)
  shared_last_failure_at String?
  shared_disabled_until  String?
  created_at             String
  updated_at             String
  model_providers        model_providers       @relation(fields: [provider_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                  users                 @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  task_token_mappings    task_token_mappings[]

  @@index([provider_id], map: "idx_model_tokens_provider_id")
  @@index([shared], map: "idx_model_tokens_shared")
  @@index([user_id], map: "idx_model_tokens_user_id")
}

/// 公众号带参二维码扫码登录会话。前端建会话拿二维码 → 用户扫码 → 微信把事件推到公众号后台
/// 配置的那个【唯一】URL（现指向 Tanva，由它按 scene 前缀 tclogin_ 转发过来）→ 落 open_id
/// → 前端轮询本表拿登录态。scene_key 前缀必须与 Tanva 的 wxlogin_ 区分开，否则两个项目抢事件。
model wechat_login_sessions {
  id            String  @id
  scene_key     String  @unique(map: "idx_wechat_login_sessions_scene_key")
  /// pending | unlinked | authorized | consumed
  status        String
  qr_ticket     String?
  qr_code_url   String?
  open_id       String?
  union_id      String?
  nickname      String?
  avatar_url    String?
  user_id       String?
  return_to     String?
  authorized_at String?
  consumed_at   String?
  expires_at    String
  created_at    String
  updated_at    String

  @@index([expires_at], map: "idx_wechat_login_sessions_expires_at")
  @@index([open_id], map: "idx_wechat_login_sessions_open_id")
}

model points_accounts {
  owner_id     String @id
  balance      Int    @default(0)
  total_earned Int    @default(0)
  total_spent  Int    @default(0)
  updated_at   String
  users        users  @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model points_ledger {
  id              String  @id
  owner_id        String
  change_amount   Int
  balance_after   Int
  source_type     String
  source_id       String?
  note            String?
  idempotency_key String
  created_at      String
  api_key_id      String?
  users           users   @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([owner_id, idempotency_key])
  @@index([owner_id, created_at(sort: Desc)], map: "idx_points_ledger_owner_created")
  @@index([api_key_id, created_at(sort: Desc)], map: "idx_points_ledger_api_key_created")
}

model product_entitlements {
  id               String   @id
  product_id       String
  owner_id         String
  entitlement_type String   @default("none")
  config_json      String?
  created_at       String
  updated_at       String
  users            users    @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products         products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([owner_id, product_id])
  @@index([owner_id, entitlement_type], map: "idx_product_entitlements_owner_type")
}

model product_images {
  id         String   @id
  product_id String
  owner_id   String
  image_url  String
  sort_order Int      @default(0)
  created_at String
  updated_at String
  users      users    @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

