{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noEmit": true, "noUnusedLocals": true, "noUnusedParameters": true, "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "skipLibCheck": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "tests"]
}
