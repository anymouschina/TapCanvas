# TapCanvas Web (Vite) 环境变量示例
# 复制为 `apps/web/.env`（该文件已在 .gitignore 中忽略）

# 后端 API base（Cloudflare Worker / Hono API）
VITE_API_BASE="http://localhost:8788"

# 对象存储显式切换；支持 tos / r2，不做自动失败回退。
VITE_OBJECT_STORAGE_PROVIDER="tos"
VITE_TOS_PUBLIC_BASE_URL="https://tanvas-ai.tos-cn-guangzhou.volces.com"
VITE_R2_PUBLIC_BASE_URL="https://assets.tapcanvas.uk"

# GitHub OAuth（用于前端发起登录）
VITE_GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
VITE_GITHUB_REDIRECT_URI="http://localhost:5173/oauth/github"

# WebCut（可选：Tapshow/WebCut 面板）
VITE_WEBCUT_URL="http://localhost:5174"

# 导演台 3D 素体 GLB（可选）
# CC0/可商用骨骼人体模型的公网 URL（建议自托管对象存储）。未设置时导演台用胶囊占位人形。
# VITE_DIRECTOR_GLB_MALE="https://<asset-host>/director/3d-characters/male.glb"
# VITE_DIRECTOR_GLB_FEMALE="https://<asset-host>/director/3d-characters/female.glb"

# 额外的自托管图片 host（可选，逗号分隔）。
# VITE_HOSTED_IMAGE_HOSTS=""

# -----------------------------
# Legacy / 未使用（仅作标记）
# -----------------------------
# 当前 `apps/web/src` 未引用该变量；如你本地有分支/旧构建依赖，可自行保留
# VITE_API_STREAM_BASE="http://localhost:9011"
